DirectoryIndex index.php
Options -Indexes
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"

# 1 Year Caching for Images, Fonts & Media (Instant load from browser cache)
<FilesMatch "\.(?:ico|jpe?g|png|gif|webp|avif|svg|woff2?|ttf|eot)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
</FilesMatch>

# 1 Month Caching for CSS and JS
<FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "max-age=2592000, public"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript text/css text/html text/xml text/plain application/json application/xml image/svg+xml font/ttf font/otf application/vnd.ms-fontobject
</IfModule>
